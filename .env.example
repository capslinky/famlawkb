# Copy this file to .env.local for local development
# These variables will be configured in Vercel dashboard for production

# Optional: Add any API keys or configuration here
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Analytics Configuration
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_API_SECRET=your-api-secret-here

# Alternative Analytics Providers
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# NEXT_PUBLIC_ANALYTICS_PROVIDER=google|plausible|custom|console

# Development Mode
# Set to 'console' for development to see analytics in console
NEXT_PUBLIC_ANALYTICS_DEBUG=false